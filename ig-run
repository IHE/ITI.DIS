#!/usr/bin/env bash
set -euo pipefail

if [[ ! -f ig.ini || ! -f sushi-config.yaml ]]; then
  echo 'Run ig-run from the guide directory.' >&2
  exit 1
fi

python3 scripts/check_semantic_group_binding.py

publisher_jar=${PUBLISHER_JAR:-input-cache/publisher.jar}
if [[ $publisher_jar != /* ]]; then
  publisher_jar="$PWD/$publisher_jar"
fi
if [[ ! -s $publisher_jar ]]; then
  echo 'Set PUBLISHER_JAR to an installed IG Publisher jar or place it in input-cache/publisher.jar.' >&2
  exit 1
fi

sushi_command=${SUSHI_COMMAND:-sushi}
if ! command -v "$sushi_command" >/dev/null; then
  echo 'Install SUSHI or set SUSHI_COMMAND to its executable path.' >&2
  exit 1
fi
"$sushi_command" build .

package_cache=${FHIR_PACKAGE_CACHE_DIR:-$HOME/.fhir}
mkdir -p "$package_cache/packages"
terminology=()
if [[ -z ${ONLINE_TX:-} ]]; then
  terminology=(-tx n/a)
fi

exec docker run --rm --pull=never \
  --cpus "${CPUS:-4}" \
  --memory "${MEMORY:-8g}" \
  --memory-swap "${MEMORY_SWAP:-10g}" \
  -e "JAVA_TOOL_OPTIONS=${JAVA_TOOL_OPTIONS:--Xmx6g -Xms1g -Dfile.encoding=UTF-8}" \
  -v "$PWD:/workspace" \
  -v "$publisher_jar:/publisher.jar:ro" \
  -v "$package_cache/packages:/root/.fhir/packages" \
  -w /workspace \
  --entrypoint java \
  "${PUBLISHER_IMAGE:-hl7fhir/ig-publisher-base:latest}" \
  -jar /publisher.jar -ig . -no-sushi "${terminology[@]}" "$@"
