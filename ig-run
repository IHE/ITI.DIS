#!/usr/bin/env bash
set -euo pipefail

# Resource controls
CPUS="${CPUS:-4}"
MEMORY="${MEMORY:-8g}"
MEMORY_SWAP="${MEMORY_SWAP:-10g}"
JAVA_TOOL_OPTIONS=${JAVA_TOOL_OPTIONS:-"-Xmx6g -Xms1g -Dfile.encoding=UTF-8"}
# Docker image for FHIR IG Publisher
PUBLISHER_IMAGE="${PUBLISHER_IMAGE:-fhir-ig-publisher:latest}"

# Persist FHIR package cache across runs
FHIR_PACKAGE_CACHE_DIR="${FHIR_PACKAGE_CACHE_DIR:-$HOME/.fhir}"
mkdir -p "$FHIR_PACKAGE_CACHE_DIR"

# Terminology mode
FORCE_OFFLINE="${FORCE_OFFLINE:-}"
ONLINE_TX="${ONLINE_TX:-}"
TX_ARG=""
if [[ -n "$ONLINE_TX" ]]; then
  TX_ARG=""
  echo "TX mode: ONLINE (override)"
elif [[ -n "$FORCE_OFFLINE" ]]; then
  TX_ARG="-tx n/a"
  echo "TX mode: OFFLINE (override)"
else
  TX_ARG="-tx n/a"
  echo "TX mode: OFFLINE (default)"
fi

# Must be run from repo root so _genonce.sh exists
if [[ ! -x "./_genonce.sh" ]]; then
  echo "Error: _genonce.sh not found in current directory. Run from the IG repo root." >&2
  exit 1
fi

# Run publisher via Docker
exec docker run --rm \
  --cpus "$CPUS" \
  --memory "$MEMORY" \
  --memory-swap "$MEMORY_SWAP" \
  -e JAVA_TOOL_OPTIONS="$JAVA_TOOL_OPTIONS" \
  -v "$PWD:/workspace" \
  -v "$FHIR_PACKAGE_CACHE_DIR:/root/.fhir" \
  -v "$FHIR_PACKAGE_CACHE_DIR:/home/publisher/.fhir" \
  -w /workspace \
  "$PUBLISHER_IMAGE" \
  bash -lc "./_genonce.sh $TX_ARG $*"
