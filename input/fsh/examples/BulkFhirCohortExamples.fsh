Instance: bulk-release-evidence
InstanceOf: DISStagedReleaseEvidence
Usage: #inline
* id = "bulk-release-evidence"
* target[0] = Reference(urn:uuid:f08e76ae-88a8-554a-9b3a-123c8dc56154)
* target[+] = Reference(urn:uuid:5cfceb42-65e1-5687-b7a7-8553eb2928e7)
* recorded = "2026-11-06T03:00:31Z"
* policy = "https://governance.example.org/fhir/Library/uc1-bulk-cohort-policy/_history/1"
* agent.type = http://terminology.hl7.org/CodeSystem/provenance-participant-type#author
* agent.who.identifier.system = "https://dis.example.org/identifiers/manager"
* agent.who.identifier.value = "example-de-id-manager"
* extension[validatedStage][0].extension[sequence].valuePositiveInt = 1
* extension[validatedStage][0].extension[stageId].valueString = "preliminary"
* extension[validatedStage][0].extension[ruleSetId].valueString = "pseudonymize-patient"
* extension[validatedStage][1].extension[sequence].valuePositiveInt = 2
* extension[validatedStage][1].extension[stageId].valueString = "advanced"
* extension[validatedStage][1].extension[ruleSetId].valueString = "generalize-birth-date"
* text.status = #generated
* text.div = "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>The De-ID Manager validated both stages before releasing the cohort files.</p></div>"

Instance: uc1-cohort-permit
InstanceOf: DISDataRequestAuthorizationContract
Usage: #example
Title: "UC-1 Bulk FHIR cohort authorization"
Description: "Synthetic Data Request Authorization for the associated de-identification job."
* meta.versionId = "1"
* identifier.value = "https://governance.example.org/permits/uc1-cohort-permit/versions/1"
* title = "UC-1 Bulk FHIR cohort authorization"
* authority.identifier.value = "https://governance.example.org/organizations/approval-authority"
* rule.contentAttachment.data = ""
* term[0].identifier.value = "https://governance.example.org/permits/uc1-cohort-permit/versions/1#cohort-r4"
* term[0].extension[permissionValidity].extension[inclusiveStart].valueDateTime = "2026-01-01T00:00:00Z"
* term[0].extension[permissionValidity].extension[exclusiveEnd].valueDateTime = "2028-01-01T00:00:00Z"
* term[0].offer.party[requester].reference.identifier.value = "https://study.example.org/organizations/requester"
* term[0].offer.party[resultRecipient].reference.identifier.value = "https://study.example.org/organizations/requester"
* term[0].extension[approvedPurpose].valueUri = "https://governance.example.org/purposes/cohort-research"
* term[0].extension[approvedPolicy].valueCanonical = "https://governance.example.org/policies/uc1-bulk-cohort|1.0"
