// UC-4 job and its signed policy Library.

Instance: uc4-cloud-decision-support-job
InstanceOf: DISDeIdentificationJob
Usage: #example
Description: "UC-4 synchronous job submission carrying the signed cloud decision support policy."
* identifier.system = "https://requester.example.org/dis/job-identifiers"
* identifier.value = "uc4-cloud-decision-support-job"
* status = #requested
* intent = #order
* code = https://profiles.ihe.net/ITI/DIS/CodeSystem/dis-work-order-type#de-identification-job
* input[authorization].valueReference = Reference(https://governance.example.org/fhir/Contract/uc4-care-approval/_history/1)
* input[payloadSet].valueAttachment.contentType = #application/fhir+json
* input[payloadSet].valueAttachment.url = "https://hospital.example.org/fhir/List/uc4-approved-encounter/_history/1"
* input[payloadSet].extension[payloadSet].extension[setId].valueString = "encounter-context-r4"
* input[payloadSet].extension[payloadSet].extension[permission].valueUri = "https://governance.example.org/permits/uc4-care-approval/versions/1#encounter-context-r4"
* input[payloadSet].extension[payloadSet].extension[purpose].valueUri = "https://governance.example.org/purposes/clinical-decision-support"
* input[payloadSet].extension[payloadSet].extension[payloadBinding].valueCode = #DIS-FHIR-Payload
* input[payloadSet].extension[payloadSet].extension[payloadVersion].valueCode = #R4
* input[payloadSet].extension[payloadSet].extension[manifestFormat].valueCode = #dis-resource-list
* input[payloadSet].extension[payloadSet].extension[policy].valueCanonical = "https://governance.example.org/policies/uc4-cloud-decision-support|1.0"
* input[payloadSet].extension[payloadSet].extension[policyContent].valueReference = Reference(approved-policy)
* contained = approved-policy

Instance: uc4-cloud-decision-support-policy
InstanceOf: DISPolicy
Usage: #example
* meta.versionId = "1"
* url = "https://governance.example.org/policies/uc4-cloud-decision-support"
* version = "1.0"
* name = "UC4CloudDecisionSupportPolicy"
* status = #policy
* issued = "2026-11-06T03:00:00Z"
* authority.identifier.system = "urn:ietf:rfc:3986"
* authority.identifier.value = "https://governance.example.org/organizations/approval-authority"
* applies.start = "2026-01-01"
* applies.end = "2026-12-31"
* identifier.value = "https://governance.example.org/policies/uc4-cloud-decision-support/versions/1.0"
* rule.contentAttachment.contentType = #application/ld+json
* rule.contentAttachment.data = ""
* title = "UC-4 Cloud Decision Support Policy"

Instance: approved-policy
InstanceOf: DISSignedPolicy
Usage: #inline
* id = "approved-policy"
* contentType = #application/jose
* data = ""

Instance: uc4-care-approval
InstanceOf: DISDataRequestAuthorizationContract
Usage: #example
Title: "UC-4 cloud decision support authorization"
Description: "Synthetic Data Request Authorization for the associated de-identification job."
* meta.versionId = "1"
* identifier.value = "https://governance.example.org/permits/uc4-care-approval/versions/1"
* title = "UC-4 cloud decision support authorization"
* authority.identifier.value = "https://governance.example.org/organizations/approval-authority"
* rule.contentAttachment.data = ""
* term[0].identifier.value = "https://governance.example.org/permits/uc4-care-approval/versions/1#encounter-context-r4"
* term[0].extension[permissionValidity].extension[inclusiveStart].valueDateTime = "2026-01-01T00:00:00Z"
* term[0].extension[permissionValidity].extension[exclusiveEnd].valueDateTime = "2028-01-01T00:00:00Z"
* term[0].offer.party[requester].reference.identifier.value = "https://hospital.example.org/organizations/requester"
* term[0].offer.party[resultRecipient].reference.identifier.value = "https://hospital.example.org/organizations/requester"
* term[0].extension[approvedPurpose].valueUri = "https://governance.example.org/purposes/clinical-decision-support"
* term[0].extension[approvedPolicy].valueCanonical = "https://governance.example.org/policies/uc4-cloud-decision-support|1.0"
