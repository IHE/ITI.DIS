      "target": {
        "@type": "AssetCollection",
        "source": "disdpv:personal-information",
        "refinement": [
          {
            "leftOperand": "disdpv:category",
            "operator": "eq",
            "rightOperand": {
              "@id": "pd:Name"
            }
          },
          {
            "leftOperand": "disdpv:personRole",
            "operator": "eq",
            "rightOperand": {
              "@id": "disdpv:care-provider"
            }
          },
          {
            "leftOperand": "disdpv:location",
