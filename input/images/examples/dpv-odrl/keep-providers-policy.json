            }
          },
          {
            "leftOperand": "disdpv:location",
            "operator": "eq",
            "rightOperand": {
              "@id": "disdpv:structured"
            }
          }
        ]
      },
      "action": "dis:remove"
    }
  ],
  "dis:ruleSets": {
    "@list": [
      {
        "dis:ruleSetId": "structured-names",
        "dis:ruleOrder": {
          "@list": [
            {
              "@id": "https://governance.example.org/policies/keep-providers/versions/1.0#keep"
