            }
          }
        ]
      },
      "action": "dis:keep"
    },
    {
      "uid": "https://governance.example.org/policies/keep-providers/versions/1.0#remove",
      "target": {
        "@type": "AssetCollection",
        "source": "disdpv:personal-information",
        "refinement": [
          {
            "leftOperand": "disdpv:category",
            "operator": "eq",
            "rightOperand": {
              "@id": "pd:Name"
            }
          },
          {
            "leftOperand": "disdpv:personRole",
            "operator": "eq",
            "rightOperand": {
