{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://profiles.ihe.net/ITI/DIS/schemas/dis-lookup-table.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tableId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": "1"
    },
    "identity-linkage-scope": {
      "$ref": "#/$defs/resolvedScope"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/identifierMapping"
      }
    }
  },
  "required": [
    "tableId",
    "version",
    "identity-linkage-scope",
    "entries"
  ],
  "title": "DIS Lookup Table",
  "description": "Patient identifier mappings for supplied and task-generated lookup tables.",
  "$defs": {
    "identifierMapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceSystem": {
          "type": "string",
          "minLength": 1
        },
        "sourceValue": {
          "type": "string",
          "minLength": 1
        },
        "targetSystem": {
          "type": "string",
          "minLength": 1
        },
        "targetValue": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sourceSystem",
        "sourceValue",
        "targetSystem",
        "targetValue"
      ]
    },
    "nonBlankString": {
      "type": "string",
      "pattern": "\\S"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "job",
            "source-institution",
            "cross-community"
          ]
        },
        "identifier": {
          "$ref": "#/$defs/scopeIdentifier"
        }
      },
      "required": [
        "type"
      ]
    },
    "resolvedScope": {
      "allOf": [
        {
          "$ref": "#/$defs/scope"
        },
        {
          "required": [
            "identifier"
          ]
        }
      ]
    }
  }
}
