{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://profiles.ihe.net/ITI/DIS/schemas/dis-execution-plan.schema.json",
  "title": "DIS FHIR Execution Plan",
  "description": "Draft structural schema for the decoded JSON in a DIS-ExecutionPlan Library attachment.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "planVersion": {
      "const": "1.0"
    },
    "ruleSetId": {
      "$ref": "dis-policy.schema.json#/$defs/nonBlankString"
    },
    "payloadBinding": {
      "const": "DIS-FHIR-Payload"
    },
    "payloadVersion": {
      "enum": [
        "R4",
        "R5"
      ]
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "dis-policy.schema.json#/$defs/rule"
          },
          {
            "required": [
              "sourceRuleId"
            ],
            "properties": {
              "target": {
                "not": {
                  "pattern": "^\\s*@"
                }
              }
            },
            "if": {
              "required": [
                "parameters"
              ],
              "properties": {
                "action": {
                  "const": "hash"
                },
                "parameters": {
                  "required": [
                    "mode"
                  ],
                  "properties": {
                    "mode": {
                      "const": "salted"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "required": [
                    "identity-linkage-scope"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "planVersion",
    "ruleSetId",
    "payloadBinding",
    "payloadVersion",
    "rules"
  ]
}
