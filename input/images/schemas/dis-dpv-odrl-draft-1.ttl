@prefix disdpv: <https://profiles.ihe.net/ITI/DIS/odrl/dpv/draft-1#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://profiles.ihe.net/ITI/DIS/schemas/dis-dpv-odrl-draft-1.ttl>
    a owl:Ontology ;
    dct:title "DIS DPV–ODRL policy vocabulary, draft 1"@en ;
    rdfs:seeAlso <https://profiles.ihe.net/ITI/DIS/draft-dpv-odrl-policy.html> .

disdpv:Policy a dct:Standard ;
    rdfs:label "Draft DIS DPV De-Identification Policy"@en .

disdpv:ExecutionPlan a dct:Standard ;
    rdfs:label "Draft DIS DPV Execution Plan"@en .

disdpv:personal-information a odrl:AssetCollection ;
    rdfs:label "Occurrences of personal information in the assigned scope"@en .

disdpv:category a odrl:LeftOperand ;
    rdfs:label "DPV personal data category of the occurrence"@en .

disdpv:personRole a odrl:LeftOperand ;
    rdfs:label "Role of the person for the occurrence in the record"@en .

disdpv:location a odrl:LeftOperand ;
    rdfs:label "Location of the occurrence"@en .

disdpv:mappingRevision a rdf:Property ;
    rdfs:label "Immutable payload mapping revision used to compile the execution plan"@en .

disdpv:patient a skos:Concept ; skos:prefLabel "Patient"@en .
disdpv:patient-contact a skos:Concept ; skos:prefLabel "Patient contact"@en .
disdpv:care-provider a skos:Concept ; skos:prefLabel "Care provider"@en .
disdpv:all-person-roles a skos:Concept ; skos:prefLabel "All person roles"@en .

disdpv:structured a skos:Concept ; skos:prefLabel "Structured elements"@en .
disdpv:narrative a skos:Concept ; skos:prefLabel "Narrative or free text"@en .
disdpv:pixel a skos:Concept ; skos:prefLabel "Image pixels"@en .

disdpv:related-person a skos:Concept ; skos:prefLabel "Related person"@en .
disdpv:person-record a skos:Concept ; skos:prefLabel "Person described by a person record"@en .
disdpv:family-member a skos:Concept ; skos:prefLabel "Family member"@en .
disdpv:contact-person a skos:Concept ; skos:prefLabel "Named contact"@en .
disdpv:subscriber a skos:Concept ; skos:prefLabel "Insurance subscriber"@en .
disdpv:research-participant a skos:Concept ; skos:prefLabel "Research participant"@en .

disdpv:PayloadMapping a rdfs:Class ; rdfs:label "Versioned payload mapping"@en .
disdpv:MappingEntry a rdfs:Class ; rdfs:label "Payload mapping entry"@en .

disdpv:mappingEntry a rdf:Property ; rdfs:label "Mapping entry"@en .
disdpv:dpvEdition a rdf:Property ; rdfs:label "Pinned DPV edition"@en .
disdpv:fhirPackage a rdf:Property ; rdfs:label "Pinned FHIR package"@en .
disdpv:manifestFormat a rdf:Property ; rdfs:label "Applicable DIS manifest format"@en .
disdpv:coverageRule a rdf:Property ; rdfs:label "Versioned coverage rule"@en .
disdpv:expansionOrder a rdf:Property ; rdfs:label "Entry expansion order"@en .
disdpv:targetPath a rdf:Property ; rdfs:label "Path to the target element"@en .
disdpv:selectorLanguage a rdf:Property ; rdfs:label "Selector language"@en .
disdpv:roleRule a rdf:Property ; rdfs:label "Versioned role determination rule"@en .
disdpv:expansionRule a rdf:Property ; rdfs:label "Versioned selector expansion rule"@en .
